# Configuration par défaut du système de déploiement

# Informations de connexion SSH
SSH_USER="qiwiiz"
SSH_HOST="51.159.6.66"
SSH_PASSWORD="IFQ3iaq3QS"

# Répertoires sur le serveur
REMOTE_DEPLOY_DIR="/var/www"
NGINX_CONFIG_DIR="/etc/nginx/sites-available"
NGINX_ENABLED_DIR="/etc/nginx/sites-enabled"
BACKUP_DIR="/tmp/deploy-backups"

# Configuration locale
LOG_FILE="deploy.log"
DEPLOY_CONFIG_FILE="deploy-config.json"

# Ports par défaut pour les frameworks
DEFAULT_NODE_PORT=3000
DEFAULT_PYTHON_PORT=5000
DEFAULT_NEXT_PORT=3001

# Configuration nginx
NGINX_WORKER_PROCESSES="auto"
NGINX_WORKER_CONNECTIONS=1024

# Configuration des sauvegardes
BACKUP_RETENTION_DAYS=7
LOG_RETENTION_DAYS=30

# Configuration SSL
SSL_EMAIL="admin@qiwiiz.space"
SSL_COUNTRY="FR"
SSL_STATE="France"
SSL_CITY="Paris"
SSL_ORG="Qiwiiz Startup"

# Configuration monitoring
MONITORING_INTERVAL=300  # 5 minutes
DISK_USAGE_THRESHOLD=80
MEMORY_USAGE_THRESHOLD=90

# Configuration des services
SERVICE_USER="www-data"
SERVICE_GROUP="www-data"
SERVICE_RESTART_DELAY=10

# Configuration des logs
LOG_LEVEL="INFO"
LOG_FORMAT="main"
ACCESS_LOG="/var/log/nginx/access.log"
ERROR_LOG="/var/log/nginx/error.log"

# Configuration de sécurité
FAIL2BAN_BANTIME=3600
FAIL2BAN_FINDTIME=600
FAIL2BAN_MAXRETRY=3

# Configuration du pare-feu
UFW_ALLOW_PORTS="80 443 22"
UFW_ALLOW_APP_PORTS="3000:3002:3003:3004:5000:3001:8080:8081:3333:4433:5555:6666:7777:8888:9999"

# Configuration des certificats SSL
CERTBOT_AUTO_RENEW=true
CERTBOT_RENEW_HOOK="systemctl reload nginx"
